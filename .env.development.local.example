# Copy to .env.development.local to point `npm run dev` at the Firebase
# emulators instead of the real project. See docs/dev-environment.md.
#
# Why this file and not an edit to .env.local: `next dev` loads
# .env.development.local BEFORE .env.local and the first file to define a key
# wins (verified against the installed @next/env 16.3.5 — see the doc). So
# this file overrides production credentials for development without
# .env.local being touched, and deleting it restores the previous behaviour
# exactly.
#
# Every key production defines has to be overridden here, not just the
# emulator hosts: a key this file leaves out still falls through to
# .env.local's real value.

# --- Emulator switches ---
# Read by the Admin SDK itself (@google-cloud/firestore and firebase-admin),
# host:port with no scheme. Setting FIRESTORE_EMULATOR_HOST is also what
# lib/firebase/admin.ts branches on to initialize without a credential.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
# Read by lib/firebase/client.ts in the browser, where env vars from the
# shell are not available and the connect* calls must be made explicitly.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=1

# --- Client SDK: a demo project, which firebase-tools forces fully offline ---
# The "demo-" prefix is not cosmetic: firebase-tools treats it as a fake
# project id and refuses to contact Google for it.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-convert2uni
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-convert2uni.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=demo-app-id

# --- Admin SDK: no service account at all ---
# The emulator accepts any caller, so the two credential values are blanked
# rather than replaced. Blank still counts as "defined" to @next/env, which
# is the point: it stops the real values in .env.local being picked up.
FIREBASE_ADMIN_PROJECT_ID=demo-convert2uni
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=demo-convert2uni.firebasestorage.app

# --- Paid providers, off ---
# Blanked for the same reason: a local experiment should not be able to spend
# money even if AI_RESOLUTION_ENABLED gets flipped on while debugging.
AI_RESOLUTION_ENABLED=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Rollout flags, off ---
# Blank, not absent, for the reason above: a blank value here wins over
# whatever .env.local says, so local development starts with the fallback
# pipeline off. Set it to 1 here deliberately to try it against the emulators.
NEXT_PUBLIC_ENABLE_FALLBACK_PIPELINE=
