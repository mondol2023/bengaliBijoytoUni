# Copy to .env.local and fill in with values from a real Firebase project.
# See docs/firebase-setup.md for exact steps. Until these are set, the app
# runs fine with sign-in/persistence disabled (isFirebaseConfigured /
# isFirebaseAdminConfigured both resolve to false) — nothing crashes.

# --- Client SDK (safe to expose to the browser; from Project settings > General > Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Admin SDK (server-only secrets — never prefix with NEXT_PUBLIC_, never commit) ---
# From Project settings > Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private_key value from the downloaded JSON as-is (its literal
# "\n" sequences are converted to real newlines in lib/firebase/admin.ts).
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=

# --- AI conversion-resolution providers (server-only — see docs/conversion-failure-pipeline.md §7) ---
# The master switch, off unless set to exactly 1/true/yes/on. Holding API keys
# is not consent to spend them: with this unset, getResolutionProvider() returns
# "provider_disabled" and no outbound call is possible regardless of the keys
# below. Anything else (empty, "0", a typo) means disabled — it fails closed.
AI_RESOLUTION_ENABLED=
#
# Whether the published known-patterns snapshot may carry AI candidates that
# no admin has accepted. Same fail-closed rule as above: unset, empty or a
# typo all mean off, and off means only human-accepted resolutions are served.
# When on, every unreviewed entry is labelled "AI-suggested, unverified" in
# the payload itself. Independent of the switch above — this one governs what
# is *served*, not what is *called*.
SERVE_UNVERIFIED_AI=
#
# Whole-document AI transcription on the documents page (lib/ai/transcribeDocument.ts):
# the fallback used when the converter scores a file below 80% or cannot read
# it, and the target of the "Convert with Gemini" button. Its own switch, same
# fail-closed parsing: AI_RESOLUTION_ENABLED does not arm it, and this does not
# arm resolution. Sends the visitor's whole file to Gemini; shares the
# AI_DAILY_CALL_BUDGET below. Needs GEMINI_API_KEY.
AI_TRANSCRIPTION_ENABLED=
# Optional. Model for transcription; defaults to gemini-2.5-flash.
GEMINI_TRANSCRIPTION_MODEL=
#
# /ocr: re-reading lines the in-browser OCR was unsure about with an AI vision
# provider (lib/ai/ocrImages.ts, POST /api/ocr/improve). Signed-in users only;
# only cropped line images are sent, never the document. One switch, one model
# and one budget PER PROVIDER (OCR_<ID>_...). Same fail-closed parsing: neither
# AI_RESOLUTION_ENABLED nor AI_TRANSCRIPTION_ENABLED arms it. Needs GEMINI_API_KEY.
OCR_GEMINI_ENABLED=
# REQUIRED, no default: Google has retired model ids before (gemini-2.5-flash is
# 404 for new keys), and a default that fails silently is how that goes
# unnoticed. Unset means the provider is not configured. Pick one with
# models.list and check it on a real crop first (docs/ocr-extraction-plan.md §11).
OCR_GEMINI_MODEL=
# Calls per UTC day for this provider, separate from AI_DAILY_CALL_BUDGET. Unset
# takes the built-in default (100); anything else not a non-negative integer is 0.
OCR_GEMINI_DAILY_CALL_BUDGET=
#
# Rollout switch for the fallback pipeline in the text converter. Off (unset,
# empty or a typo), the converter calls the engine directly and looks exactly
# as it did before Phase 6. On, it fetches the known-patterns snapshot and
# fills sequences the engine cannot map from human-accepted resolutions,
# marked as such. NEXT_PUBLIC_ because it is read in the browser, which also
# means it is fixed at build time: turning it off is "unset and rebuild".
# Do not turn on before the copy in docs/pending-manual-steps.md §3 is approved.
NEXT_PUBLIC_ENABLE_FALLBACK_PIPELINE=
#
# A ceiling on outbound provider calls per UTC day, as a backstop behind the
# per-admin rate limit. Unset takes the built-in default; anything present
# but not a non-negative integer is read as 0, because a typo in a spending
# limit must not read as a larger limit. It counts calls, not currency —
# nothing here records a per-token price, and a dollar figure we cannot
# compute would look like a guarantee. Per-instance, like the rate limiter:
# on a multi-instance host the real ceiling is this times the instance count.
AI_DAILY_CALL_BUDGET=
#
# Optional. Until set, the corresponding provider's isConfigured() is false and
# resolve() returns a controlled "provider_not_configured" error — nothing crashes,
# and no AI call happens automatically either way (see §7.1).
GEMINI_API_KEY=
OPENAI_API_KEY=
