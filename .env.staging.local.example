# Copy to .env.staging.local (gitignored) for the staging scripts ONLY:
#
#   npm run staging:firebase -- <deploy|ttl|seed|unseed|probe> [--apply]
#
# Next.js never loads this file, so it cannot leak into `npm run dev` or a
# build, and it never replaces .env.local (which points at Production).
# See docs/staging-environment.md. No values belong in this template.

# The staging project. Required by every staging script; legacy2uni is refused.
STAGING_FIREBASE_PROJECT_ID=

# Admin SDK for seed/unseed/probe. Must be a service account OF the staging
# project: FIREBASE_ADMIN_PROJECT_ID must equal STAGING_FIREBASE_PROJECT_ID and
# the client email must end @<staging-id>.iam.gserviceaccount.com, or the
# script refuses. Never reuse the Production service account.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
